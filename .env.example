# Template only. No real credentials belong in this file.
# All five values are required; empty values make Compose reject the configuration.
# Supply distinct, strong passwords through the environment or an ignored .env.
# Generated alphanumeric passwords avoid quoting issues in the official bootstrap.
# In a .env file, single-quote values containing $ to prevent interpolation.
TY_E2_MYSQL_ROOT_PASSWORD=
TY_E2_EVENTOS_DB_PASSWORD=
TY_E2_INVENTARIO_DB_PASSWORD=
TY_E2_ENTRADAS_DB_PASSWORD=
TY_E2_COMPRAS_DB_PASSWORD=

# Optional identity profile. Provision its database separately before activation.
# Do not put key material here. IDENTITY_KEYS_DIR must be outside the repository.
TY_E2_IDENTIDAD_DB_PASSWORD=
IDENTITY_KEYS_DIR=
IDENTITY_JWT_ISSUER=http://identidad:8085
IDENTITY_JWT_KEY_ID=identity-key-1

# These values initialize a NEW project volume only.
# Changing them later does not rotate passwords stored in an existing database.
# Never reuse development/test volumes or override this project's name to theirs.

# Seven independent OAuth2 client secrets. Provision only after persistent migration approval.
TY_SECURITY_EVENTOS_INVENTARIO_SECRET=
TY_SECURITY_EVENTOS_ENTRADAS_SECRET=
TY_SECURITY_EVENTOS_COMPRAS_SECRET=
TY_SECURITY_COMPRAS_EVENTOS_SECRET=
TY_SECURITY_COMPRAS_INVENTARIO_SECRET=
TY_SECURITY_COMPRAS_ENTRADAS_SECRET=
TY_SECURITY_ENTRADAS_COMPRAS_SECRET=
