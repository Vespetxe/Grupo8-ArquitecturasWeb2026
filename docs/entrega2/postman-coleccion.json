  "item": [
    {
      "name": "Registrar CLIENTE",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "description": "Usar únicamente un Gateway aislado propio. JWT/rol/propiedad son autoridad del servidor; completar IDs reales y no ejecutar toda la colección automáticamente.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Login real",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "description": "Usar únicamente un Gateway aislado propio. JWT/rol/propiedad son autoridad del servidor; completar IDs reales y no ejecutar toda la colección automáticamente.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200){const b=pm.response.json();pm.collectionVariables.set('jwt',b.access_token);}"
            ]
          }
        }
      ]
    },
